# Python 缓存
__pycache__/
*.py[cod]

# 虚拟环境
.venv/
.venv-*/
venv/

# 桌面打包产物 —— 二进制通过 Releases 分发，不进仓库
build/
dist/
*.spec

# Android / buildozer 产物
bin/
.buildozer/
.p4a/
