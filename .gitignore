*.aab
*.keystore

# 本地配置与密钥 —— 绝对不要提交
option.yml
option.local.yml
.env

# 下载内容（本工具会主动写入这些文件）
downloads/
*.pdf
*.zip
*.png
!assets/**/*.png

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
